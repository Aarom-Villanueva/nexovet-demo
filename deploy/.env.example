# Copiar a .env.deploy en la raíz (permisos 0600). No usar claves de desarrollo.
# Generar DOS claves distintas: openssl rand -hex 32. Usar solo hexadecimal en DB_PASSWORD.
DB_OWNER_PASSWORD=
DB_PASSWORD=
DB_NAME=nexovet
APP_ORIGIN=https://vet.example.com
SITE_ADDRESS=vet.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=nexovet@example.com
# Imágenes identificadas por commit; conservar también la versión anterior.
API_IMAGE=nexovet-api:local
WEB_IMAGE=nexovet-web:local
# PUBLISH_HOST=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
