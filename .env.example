# Solo desarrollo local. No usar estas credenciales en un servidor público.
DATABASE_URL=postgresql://nexovet:nexovet_local_only@127.0.0.1:5432/nexovet_dev
TEST_DATABASE_URL=postgresql://nexovet:nexovet_local_only@127.0.0.1:5432/nexovet_test
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
ENABLE_DEMO=true

# Origen público de la aplicación, sin barra final. En producción: HTTPS.
APP_ORIGIN=http://localhost:5173
# local escribe en .local/mail/; no envía correos reales. Producción exige smtp.
MAIL_DELIVERY=local
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=nexovet@example.invalid
